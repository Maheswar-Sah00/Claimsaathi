# Copy to .env and fill in locally. Never commit .env.

# --- Agent ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BROWSER=local                      # local | browserbase
PORTAL_BASE_URL=http://127.0.0.1:8001
AGENT_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=data/claimsaathi.db
VAULT_DIR=vault_samples           # synthetic family documents (seed files under seed/)
EVIDENCE_DIR=evidence             # per-run screenshots and HTML (git-ignored)

# --- Portal adapter (Playwright) ---
PORTAL_USERNAME=arjun             # synthetic demo account on the mock portal
PORTAL_PASSWORD=demo123
PORTAL_HEADLESS=true              # false shows the browser window
PORTAL_TIMEOUT_MS=15000
PORTAL_UPLOAD_TIMEOUT_MS=10000

# --- Document matching ---
# Pre/post-hospitalisation days covered by the policy. Leave empty unless the policy states them;
# then only the admission-to-discharge window is accepted.
POLICY_PRE_ADMISSION_DAYS=
POLICY_POST_ADMISSION_DAYS=
LOG_LEVEL=INFO
AGENT_SESSION_SECRET=change-me-to-a-long-random-string
AGENT_HTTPS_ONLY_COOKIES=false       # true behind HTTPS

# --- Optional cloud browser (only when BROWSER=browserbase) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Synthetic portal ---
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string
PORTAL_HTTPS_ONLY_COOKIES=false
PORTAL_DATA_DIR=data/portal
PORTAL_MAX_UPLOAD_MB=5
PORTAL_FAULT_DELAY_SECONDS=30
